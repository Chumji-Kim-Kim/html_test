    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            // 1. Typed.js for title typed dynamic effect
            new Typed('#typed-title', {
                strings: [
                    '한국전력공사 ^500<br>성과보상체계 개선 방안',
                    '공정성 확보 및 ^300<br>보상 다각화 전략 프레임워크'
                ],
                typeSpeed: 60,
                backSpeed: 40,
                loop: true,
                backDelay: 2500
            });

            // 2. Fullpage.js initialization with AOS conflict solver logic
            new fullpage('#fullpage', {
                autoScrolling: true,
                scrollBar: false, // smooth programmatic scroll
                navigation: true,
                navigationPosition: 'right',
                scrollingSpeed: 850,
                easingcss3: 'cubic-bezier(0.645, 0.045, 0.355, 1)',
                
                // CRITICAL FIX: To prevent AOS from remaining transparent on desktops 
                // due to fullpage custom scroll containers handling intersection observer differently:
                onLeave: function(origin, destination, direction) {
                    // Remove animation class from elements leaving the screen
                    const leavingElements = origin.item.querySelectorAll('[data-aos]');
                    leavingElements.forEach(function(el) {
                        el.classList.remove('aos-animate');
                    });
                },
                afterLoad: function(origin, destination, direction) {
                    // Force trigger animation on active screen elements immediately
                    const activeElements = destination.item.querySelectorAll('[data-aos]');
                    activeElements.forEach(function(el) {
                        el.classList.add('aos-animate');
                    });
                    // Refresh positionings
                    AOS.refresh();
                }
            });

            // 3. AOS Animation initialization
            AOS.init({
                duration: 800,
                easing: 'ease-out-quad',
                once: false, // dynamic re-triggering allowed via fullpage hooks
                mirror: true
            });

            // 4. Accordion Toggle Script
            const accordionHeaders = document.querySelectorAll('.accordion-header');
            accordionHeaders.forEach(header => {
                header.addEventListener('click', function() {
                    const parent = this.parentElement;
                    const content = this.nextElementSibling;
                    const isActive = parent.classList.contains('active');
                    
                    // Close all adjacent items first
                    const allItems = parent.parentElement.querySelectorAll('.accordion-item');
                    allItems.forEach(item => {
                        item.classList.remove('active');
                        item.querySelector('.accordion-content').style.maxHeight = '0px';
                    });
                    
                    // Toggle current item
                    if (!isActive) {
                        parent.classList.add('active');
                        content.style.maxHeight = content.scrollHeight + 'px';
                    }
                });
            });

            // 5. Swiper for Benchmarking Slides Carousel
            new Swiper('.benchSwiper', {
                slidesPerView: 'auto',
                spaceBetween: 25,
                centeredSlides: false,
                grabCursor: true,
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
                breakpoints: {
                    320: { slidesPerView: 1, spaceBetween: 15 },
                    768: { slidesPerView: 2, spaceBetween: 20 },
                    1200: { slidesPerView: 3, spaceBetween: 25 }
                }
            });

            // 6. Chart.js Data Visualization Rendering
            const ctx = document.getElementById('satisfactionChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['평가방법 공정성 확보', '연봉 차등수준 조정', '평가지표 개선/세분화', '기타 의견'],
                    datasets: [{
                        label: '우선 개선 필요 비율 (%)',
                        data: [47.8, 31.9, 15.2, 5.1],
                        backgroundColor: [
                            'rgba(0, 80, 136, 0.9)',   // KEPCO Blue
                            'rgba(237, 28, 36, 0.9)',   // KEPCO Red
                            'rgba(14, 165, 233, 0.8)',  // Light Accent Blue
                            'rgba(148, 163, 184, 0.8)'  // Slate Gray
                        ],
                        borderColor: [
                            '#005088',
                            '#ED1C24',
                            '#0EA5E9',
                            '#94A3B8'
                        ],
                        borderWidth: 1.5,
                        borderRadius: 8,
                        barThickness: 35
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ' ' + context.raw + '%';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: 'Pretendard', weight: '600' } }
                        },
                        y: {
                            beginAtZero: true,
                            max: 60,
                            ticks: { stepSize: 15, font: { family: 'Pretendard' } }
                        }
                    }
                }
            });

        });
